# Example configuration for docker/ascend950pr/create-container.sh
#
# Adapted from the AgentGates tilelang-hivm reference
# (agent_gates/adapters/tilelang-hivm/docker/config.example.env). The structure
# and every safety note are inherited; the values and examples below are
# specific to TileFoundry on an Ascend950PR host.
#
# Copy this file to `config.env` next to it and edit the values:
#
#     cp config.example.env config.env
#     ./create-container.sh --config ./config.env --dry-run
#     ./create-container.sh --config ./config.env
#
# `config.env` is git-ignored: it holds machine-specific identities and paths and
# must not be committed. This template is committed; a config.env is not.
#
# EVERY value below is empty on purpose. Sourcing an empty assignment is the same
# as not setting the key, so the script's own default applies and this template
# never pins a value nobody reviewed. The commented lines show the SHAPE of a
# value; none of them is a value from any machine.
#
# Every value is plain Bash, so a list is a space-separated string and the script
# splits it on whitespace. Any value that contains spaces MUST be quoted (a bare
# `VAR=a b` would run `b` as a command when this file is sourced).

# ---------------------------------------------------------------------------
# What this container is for, and what it is NOT allowed to do
# ---------------------------------------------------------------------------
# It runs TileFoundry against a real Ascend950PR: import the tree, run the CLI,
# finalize HIR to TIR, compile. It is not a way to change the machine.
#
#   * the host driver and CANN are BIND-MOUNTED read-only, never installed,
#     upgraded or patched from inside;
#   * the host NPU driver is never touched and no kernel module is loaded;
#   * the container gets ONLY the devices named in NPU_DEVICES below. On a
#     shared host that is the difference between a test and an incident.
#
# The TileFoundry source tree and the Python venv must both be reachable through
# the bind mounts below; a source tree that no mount covers is refused outright.

# ---------------------------------------------------------------------------
# Image and container identity
# ---------------------------------------------------------------------------
# Image built from ./Dockerfile (see README.md for the build command). It must
# exist locally; the script never pulls implicitly.
# Default when empty: tilefoundry-ascend950pr-dev:24.04
IMAGE=

# Name of the container to create. Required. Must not already exist.
CONTAINER_NAME=

# Hostname inside the container. Default when empty: CONTAINER_NAME with `_`
# turned into `-`.
CONTAINER_HOSTNAME=

# Account created inside the container. Required.
CONTAINER_USER=

# UID/GID of that account. Required, numeric, non-zero. Set them to the host
# account that owns the bind-mounted source tree and venv, so the container can
# read them. Get the real values with:
#     stat -c '%u %g' <host home>
# A mismatch makes a login shell in the container fail with "Permission denied"
# on ~/.bashrc; create-container.sh rejects it before creating anything.
CONTAINER_UID=
CONTAINER_GID=

# Supplementary GIDs added to the account. Default when empty: none. On an
# Ascend host this commonly includes the group that owns the driver device
# nodes, so the container account can open /dev/davinci0. Get it with:
#     stat -c '%g' /dev/davinci0
SUPPLEMENTARY_GIDS=

# HOME inside the container. Required, absolute, not `/`. It is normally covered
# by the /home bind mount; the scripts never create or chown it.
CONTAINER_HOME=

# ---------------------------------------------------------------------------
# Runtime configuration
# ---------------------------------------------------------------------------
# Network mode. Default when empty: host, which is what the Ascend runtime and
# anything talking to a local daemon expects.
NETWORK=

# Run privileged. Default when empty: true. Ascend device access generally needs
# it. NOTE: privileged makes NPU_DEVICES advisory rather than a hard limit,
# because the container can then see every host device. On a shared host prefer
# PRIVILEGED=false plus explicit NPU_DEVICES, so device 0 is the ONLY card this
# container can reach. That trade is yours to make; it is not made for you.
PRIVILEGED=

# cgroup namespace mode. Default when empty: host, which matches the reference
# environment.
CGROUPNS=

# --security-opt values, space separated. Default when empty: label=disable,
# which is SELinux-only and harmless elsewhere.
SECURITY_OPTS=

# Shared memory size and locked-memory limit. Defaults when empty: 512g and
# 150000000000:150000000000. The CANN runtime locks large memory regions, so a
# small memlock makes device initialisation fail in a way that reads as a driver
# fault.
SHM_SIZE=
MEMLOCK=

# Value of ASCEND_RT_VISIBLE_DEVICES inside the container. Empty or omitted both
# mean "no filtering": the variable is exported empty, which the runtime reads as
# "no restriction". There is deliberately no literal default, because one would
# let a file that merely leaves the line out expose cards nobody allocated.
#
# THIS IS THE DEVICE ISOLATION KNOB. Set it to 0 to expose only device 0:
#   ASCEND_VISIBLE_DEVICES=0
ASCEND_VISIBLE_DEVICES=

# Explicit device nodes to pass through (space separated). Default when empty:
# none. ASCEND_RT_VISIBLE_DEVICES alone passes no devices: real access needs the
# driver mounts, the device nodes and the host runtime.
#
# Device 0 only, with the manager nodes the runtime needs to reach it:
#   NPU_DEVICES="/dev/davinci0 /dev/davinci_manager /dev/hisi_hdc"
# Add /dev/devmm_svm only if the host has it (`ls` it first); passing a node that
# does not exist makes docker create an empty file in its place, which then fails
# obscurely inside the container.
NPU_DEVICES=

# ---------------------------------------------------------------------------
# Mounts
# ---------------------------------------------------------------------------
# Required mounts, format `source:destination[:ro|rw]`. A missing source is a
# hard error: create-container.sh never lets Docker create an unexpected
# directory.
#
# Three things must be covered or the container is useless:
#   * the TileFoundry source tree;
#   * the CANN installation, read-only -- nothing in the container may write to
#     it and nothing may upgrade it;
#   * the Python venv that has torch and TileFoundry's dependencies.
#
# Shape on the reference host:
#   BIND_MOUNTS="${CANN_ROOT}:${CANN_ROOT}:ro"
#   BIND_MOUNTS="$BIND_MOUNTS ${HOME}/workspace/TileFoundry:${HOME}/workspace/TileFoundry"
#   BIND_MOUNTS="$BIND_MOUNTS ${HOME}/workspace/tfpy312:${HOME}/workspace/tfpy312"
#
# Keep same-path mounts (/data:/data) unless you have a reason to remap: the
# container then sees the same absolute paths the host does, so a recorded
# command replays in either place without rewriting paths.
BIND_MOUNTS=

# Optional mounts, same format. A missing source is reported and skipped, not an
# error. This is where hardware-specific paths belong, so the same script works
# on a machine without an NPU. Shape on the reference host:
#   OPTIONAL_BIND_MOUNTS="/usr/local/Ascend/driver:/usr/local/Ascend/driver:ro"
#   OPTIONAL_BIND_MOUNTS="$OPTIONAL_BIND_MOUNTS /usr/local/sbin/npu-smi:/usr/local/sbin/npu-smi:ro"
#   OPTIONAL_BIND_MOUNTS="$OPTIONAL_BIND_MOUNTS /etc/ascend_install.info:/etc/ascend_install.info:ro"
OPTIONAL_BIND_MOUNTS=

# ---------------------------------------------------------------------------
# Lifecycle
# ---------------------------------------------------------------------------
# Default when empty: true. true keeps the container alive after identity
# initialization (`tail -f /dev/null`), which is what a long-running dev
# container needs. false runs CONTAINER_COMMAND instead and the container exits.
LONG_RUNNING=

# Command run when LONG_RUNNING=false. Mutually exclusive with LONG_RUNNING=true;
# the script refuses both at once.
CONTAINER_COMMAND=

# Seconds create-container.sh waits for the entrypoint to create and verify the
# container identity before it reports failure. Default when empty: 30.
INIT_TIMEOUT_SECONDS=
