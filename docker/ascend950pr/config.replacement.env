# Machine-specific configuration for docker/ascend950pr/create-container.sh
# Generated for this host; NOT committed (.gitignore covers config.env).
# Host: s00653124 uid/gid 1071, Ascend950PR device 0 only.

IMAGE=tilefoundry-ascend950pr-dev:24.04
CONTAINER_NAME=tf-ascend950pr
CONTAINER_HOSTNAME=tf-ascend950pr
CONTAINER_USER=s00653124
CONTAINER_UID=1071
CONTAINER_GID=1071
# /dev/davinci0 is 1001:1001 (HwHiAiUser); the account is added to that group.
SUPPLEMENTARY_GIDS="1001"
CONTAINER_HOME=/home/s00653124

# Not privileged: device access comes from the explicit NPU_DEVICES below, so
# device 0 is the only card this container can reach. Privileged would make the
# device list advisory.
PRIVILEGED=false
NETWORK=host
CGROUPNS=host

# Device 0 only. /dev/devmm_svm does not exist on this host, so it is omitted:
# passing a missing node makes docker create an empty file in its place.
ASCEND_VISIBLE_DEVICES=0
NPU_DEVICES="/dev/davinci0 /dev/davinci_manager /dev/hisi_hdc"

# --- mounts ---------------------------------------------------------------
# CANN and /data are read-only: nothing in the container may write to CANN or
# upgrade it. /data also carries the shared conda (conda.sh) used to create OUR
# OWN envs under $HOME/.conda/envs. No other user's env is read or activated.
BIND_MOUNTS="/data:/data:ro"

# /opt/tf-venv is DEPRECATED and deliberately not mounted. The canonical
# interpreter is now the conda env at $HOME/.conda/envs/tilefoundry-npu, which
# /home already makes visible. Nothing should depend on /opt.

# Vendor wheels: torch 2.10.0+cpu and the matching torch_npu are cp311-only and
# are installed --no-deps from here, because PyPI torch resolves to a CUDA build
# on this host.
BIND_MOUNTS="$BIND_MOUNTS /home/s00653124/Packages:/home/s00653124/Packages:ro"

# /home is mounted whole, which is what the other AgentGates adapters do and what
# the user asked for. It makes $HOME writable inside the container, so
# $HOME/.conda/envs works with the shared conda at /data/miniconda3 (mounted
# read-only above) and conda can write its own caches without being given root.
BIND_MOUNTS="$BIND_MOUNTS /home:/home"

BIND_MOUNTS="$BIND_MOUNTS /home/s00653124/workspace/TileFoundry:/home/s00653124/workspace/TileFoundry"
BIND_MOUNTS="$BIND_MOUNTS /home/s00653124/workspace/tfpy312:/home/s00653124/workspace/tfpy312"
BIND_MOUNTS="$BIND_MOUNTS /home/s00653124/workspace/TileFoundry_Ascend950PR_AgentTeam:/home/s00653124/workspace/TileFoundry_Ascend950PR_AgentTeam"

OPTIONAL_BIND_MOUNTS="/usr/local/Ascend/driver:/usr/local/Ascend/driver:ro"
OPTIONAL_BIND_MOUNTS="$OPTIONAL_BIND_MOUNTS /usr/local/sbin/npu-smi:/usr/local/sbin/npu-smi:ro"
OPTIONAL_BIND_MOUNTS="$OPTIONAL_BIND_MOUNTS /etc/ascend_install.info:/etc/ascend_install.info:ro"

LONG_RUNNING=true
INIT_TIMEOUT_SECONDS=60