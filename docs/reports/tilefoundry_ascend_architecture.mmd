flowchart TB
    classDef hw fill:#EEF4FA,stroke:#1E3A8A,stroke-width:1.5px,color:#0F172A
    classDef boundary fill:#FEF7EB,stroke:#92400E,stroke-width:2px,color:#3B1D00
    classDef agent fill:#ECFDF5,stroke:#065F46,stroke-width:1.5px,color:#062E22
    classDef verify fill:#F5F3FF,stroke:#4C1D95,stroke-width:1.5px,color:#240E52

    subgraph PLANE_1["第一层：硬件规格建模、核心 IR 与双轨模板层（ascend/target · ir · visitor_registry · templates）"]
        P1_HW["昇腾硬件规格与事实投影\nDaVinci950 (dav_3510) + Ascend950PR (28C/56V) / 950DT (36C/72V)\n耦合 1C2V 拓扑、24-bit 通道掩码、UB 三档容量 (216/248/256 KiB)\n9 合法/3 禁用 DMA 通路与实测 HBM 分段突发带宽曲线（probes 离线标定）"]:::hw
        P1_IR["执行域、55 条 Ascend TIR 原语与 24 组 HIR->TIR 绑定\nSimdVF / SimtVF 双执行域；10 DMA + 4 DualCopy/Sync + 1 MMAD + 40 Vector\n含 MXQuant / SortTopK / BitUnpack 与 ISL 访问关系、CPU 求值及校验"]:::hw
        P1_TPL["双轨三轴协同模板引擎（7 范式壳层）\nTrack-A TileLang DSL + Track-B AscendC C++20 渲染器\n按 TopologyAxes (计算引擎×存储环×迭代规则性) 装配，支持 Top 自由态剥离"]:::hw
    end

    subgraph PLANE_2["第二层：白盒编译静态分析与代价建模层（编译器客观性边界：sil · schedule · passes · cost_model）"]
        P2_SIL["SIL 调度接口层与 7 维红线校验器\nOpAdvisoryExtractor 抽取算子画像与默认策略；TopologyAxes + 7 维 MECE 自由度掩码\nSILVerifier 执行 14 条硬件红线检查与 C++ CFG 跨核 Flag 平衡验证"]:::boundary
        P2_SOLVER["Z3 模调度求解器与分段分档求解器\nValidate/ResolveAscendPipelines Pass + Z3 稳态 II/双缓冲求解 (Mode A)\nRegimePiecewiseSolver 按分档静态/解析混合求解并支持活跃缓存不动点重算"]:::boundary
        P2_ENV["双快照降级分析器与客观物理账本\nEnvelopeInspector 捕获 TileLang TVM Pass 降级前后隐式缓存膨胀与多缓冲退化\nHirTirBridge + ObjectivePhysicalLedger 输出双模式 (exact_modulo_z3 / readonly_envelope) 遥测"]:::boundary
        P2_COST["三层混合代价模型与编译器微架构解析器\nTier 0 物理屋脊线 + 6-Pipe/AVE 连续调度模型；Tier 1 BiSheng 7 类行为惩罚\nTier 2 全局/分桶 Ridge 残差 + MSProf PMU 通道缩放 + 成对 Delta 排序"]:::boundary
        P2_SIL -->|"策略约束与 7 维掩码"| P2_SOLVER
        P2_SOLVER -->|"Z3 II / 分档策略"| P2_ENV
        P2_ENV -->|"物理账本与微架构画像"| P2_COST
    end

    subgraph PLANE_3["第三层：能力路由、因果规则库与经验演进层（agent/router · kb · orchestrator · flywheel）"]
        P3_ROUTE["8D 结构特征能力路由与 ISA 缺口扫描器\nCapabilityGate (Router ON/OFF 可消融) 路由三轨与三级升级 (DSL->InlineVF->AscendC)\nISAGapScanner 跨 7 硬件流水通道扫描 27 项 devkit 原语缺口并触发掩码松弛"]:::agent
        P3_KB["33 条跨算子因果规则库与三轴分解贝叶斯追踪器\nAST 安全静态谓词过滤；全局 + 三轴 (ce/mr/ir) 独立后验更新、剪枝与冷却复活\n支持按 run_id 无锁分片持久化与算子局部规则验证晋升"]:::agent
        P3_PORT["无状态双通道组合生成器与瓦片预筛\nPortfolioRunner 并行调度 K 路规则定向利用 + 无先验探索（含负向机制排除）\nTileSizePrescreen 预筛 16 对齐瓦片与 Half-L1 冲突；AgyCli 严控流式看门狗与 xhigh 降级"]:::agent
        P3_BEAM["分档独立双轨演进池、经验湖与反事实飞轮\n每分档维护独立 TwoLaneBeamSearch (利用轨+探索踏脚石) 与 Eq.3-HAP 复合目标\nExperienceLake 内容寻址在线回放校准；FlywheelDistiller 反事实单变量/LOO 拆解与微探针准入"]:::agent
        P3_ROUTE -->|"执行轨、升级决策与 ISA 缺口"| P3_PORT
        P3_KB -->|"按三轴后验排序的命中规则"| P3_PORT
        P3_BEAM -->|"分档父代切片、残差与负向排除"| P3_PORT
        P3_BEAM -.->|"准入经真机验证的新规则"| P3_KB
    end

    subgraph PLANE_4["第四层：多算子冲分编排与五级递进硬件验证层（agent/campaign · gate_funnel · surrogate_cannbench）"]
        P4_CAMP["多算子冲分控制器与 AST 局部拼接\nCannbenchOpsRegistry 自动发现并分层锚点；Marathon 停滞衰减轮转与启动抢救\n按分档 AST 局部符号替换并自动清理死辅助函数，保护其余分档不变"]:::verify
        P4_PYRAMID["五级验证漏斗（包装三阶段 GateFunnel A/B/C）\nL0 静态账本/7维SIL预检 -> [可选 CostModel Top-K 预筛] -> L1 离线 BiSheng 编译与资源剖析\n-> L2 预热缓存代表用例批量真机测速 + MSProf -> L3 全量契约与原子回滚 -> L4 官方全集评测"]:::verify
        P4_CAMP -->|"双轨完整候选模块"| P4_PYRAMID
    end

    %% 第一层 -> 第二层
    P1_HW -->|"硬件红线与突发带宽曲线"| P2_SIL
    P1_HW -->|"24-bit 掩码与存储上限"| P2_SOLVER
    P1_IR -->|"55 条原语延迟与合法性"| P2_ENV
    P1_TPL -->|"协同壳层与 Top 源码物化"| P4_CAMP

    %% 跨越编译器客观性边界（主干）
    P2_COST -->|"静态账本、预测延迟与蓝图差值"| P3_ROUTE
    P2_COST -->|"物理遥测与编译器摘要"| P3_KB
    P2_COST -.->|"L0->L1 Top-K 预筛排序"| P4_PYRAMID

    %% 第三层 -> 第四层前向通道
    P3_PORT -->|"候选局部内核补丁"| P4_CAMP

    %% 第四层 -> 第三层/第二层闭环反馈轨道
    P4_PYRAMID -.->|"实测 Eq.3/MSProf/BiSheng 摘要与回滚状态"| P3_BEAM
    P3_BEAM -.->|"ExperienceLake 实测与成对 Delta 校准"| P2_COST
