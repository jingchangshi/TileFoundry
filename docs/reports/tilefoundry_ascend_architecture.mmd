flowchart TB
    classDef hw fill:#EEF4FA,stroke:#2B5B84,stroke-width:1.5px,color:#12263A
    classDef boundary fill:#FDF6E9,stroke:#A66300,stroke-width:2px,color:#3B2300
    classDef agent fill:#F2F8F2,stroke:#2D6A4F,stroke-width:1.5px,color:#133122
    classDef verify fill:#F7F2FA,stroke:#6A3D9A,stroke-width:1.5px,color:#2E1647

    subgraph PLANE_1["第一层：硬件规格建模与核心中间表示层"]
        P1_CORE["高层与底层中间表示及副作用系统\n片上可寻址存储区、循环流水线建模\n与计算图数值可达性保护"]:::hw
        P1_HW["昇腾硬件规格与约束模型\nCube 与 Vector 耦合拓扑、片上分级存储容量、\n合法 DMA 通路与分段突发传输带宽曲线"]:::hw
        P1_OPS["昇腾执行域与底层算子原语\n向量与标量执行域、绑定硬件流水通道的原语\n以及面向片上存储的数据重排与搬运指令"]:::hw
    end

    subgraph PLANE_2["第二层：白盒编译静态分析层（编译器客观性边界）"]
        P2_Z3["循环模调度约束求解器（Z3）\n流水通道互斥掩码、数据与重用依赖边\n及稳态循环启动间隔（II）求解"]:::boundary
        P2_SNAP["编译降级前后对比分析器\n隐式缓存膨胀审计、多缓冲退化识别、\n突发传输周期修正与指针别名风险扫描"]:::boundary
        P2_LEDGER["静态硬件资源与理论性能评估器\nCube/Vector 屋脊线理论下限、各级片上内存水位、\n波次核心占用率与静态诊断遥测"]:::boundary
        P2_Z3 -->|"稳态启动间隔与调度方案"| P2_LEDGER
        P2_SNAP -->|"降级前后差值、修正周期与阻塞标记"| P2_LEDGER
    end

    subgraph PLANE_3["第三层：规则引导的混合搜索与经验演进层"]
        P3_DIAG["理论与实测偏差分析器及优化规则库\n对比静态理论边界与硬件实测计数器偏差；\n按算子计算范式对硬件优化规则贝叶斯排序"]:::agent
        P3_SYNTH["双通道候选内核生成器\n经验规则定向利用与无先验结构探索并行，\n生成符合分档切片约束的候选代码"]:::agent
        P3_BEAM["双轨候选演进池与经验提炼闭环\n最优性能推进轨、潜力探索分支保留、\n反事实单变量拆解与微探针准入验证"]:::agent
        P3_DIAG -->|"性能瓶颈诊断与排序规则"| P3_SYNTH
        P3_BEAM -->|"父代内核切片与负向排除约束"| P3_SYNTH
        P3_BEAM -.->|"准入经真机验证的新增规则"| P3_DIAG
    end

    subgraph PLANE_4["第四层：分档算子内核组装与多级硬件验证层"]
        P4_REGIME["按输入规模分档的算子内核模块\n面向不同形状特征特化子内核，\n支持语法树级局部符号隔离替换"]:::verify
        P4_PYRAMID["五级递进式编译与真机验证漏斗\n1. 静态资源预检 -> 2. 离线设备编译 -> 3. 代表用例批量测速与剖析\n-> 4. 全量契约回归门禁 -> 5. 官方基准全集评测"]:::verify
        P4_REGIME -->|"拼装完整算子模块"| P4_PYRAMID
    end

    %% 第一层 -> 第二层（无交叉向下连线）
    P1_CORE -->|"循环流水线与存储副作用"| P2_Z3
    P1_HW -->|"硬件通道掩码与存储上限"| P2_Z3
    P1_HW -->|"突发带宽曲线与层级容量"| P2_SNAP
    P1_OPS -->|"算子延迟与 DMA 合法规则"| P2_SNAP

    %% 跨越编译器客观性边界（单一主干）
    P2_LEDGER -->|"静态评估结果与参考蓝图"| P3_DIAG

    %% 第三层 -> 第四层前向通道（左侧主干）
    P3_SYNTH -->|"候选局部内核补丁"| P4_REGIME

    %% 第四层 -> 第三层闭环反馈（右侧回流轨道）
    P4_PYRAMID -.->|"实测得分、回滚状态与硬件性能计数器"| P3_BEAM
